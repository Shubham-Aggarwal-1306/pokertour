{
  "name": "pokertour",
  "version": "0.1.0",
  "private": true,
  "description": "Public search engine for poker tournaments worldwide, with an AI assistant to find and ask about events.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "rag:reindex": "tsx --env-file-if-exists=.env.local scripts/reindex.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.2.13",
    "@neondatabase/serverless": "^1.1.0",
    "langchain": "^1.5.14",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
