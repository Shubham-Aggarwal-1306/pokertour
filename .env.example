# --- AI chat (required for the assistant) ---
ANTHROPIC_API_KEY=
# Cheapest model by default. Upgrade to e.g. claude-sonnet-5-5 for better answers at higher cost.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Embeddings for RAG / semantic search (optional) ---
# Without it, a free local hashing embedder is used (lexical similarity only).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
# Minimum cosine similarity for a vector hit to count.
# RAG_MIN_SCORE=0.3   (defaults: 0.3 for Voyage, 0.12 for the local fallback)

# --- Database (optional) ---
# Postgres with pgvector (Neon via the Vercel Marketplace sets this; POSTGRES_URL or prefixed names also work).
# Without it the app serves bundled demo data.
DATABASE_URL=

# --- Ingestion ---
# Vercel sends this as a Bearer token to /api/cron/ingest.
CRON_SECRET=
# JSON array of sources. "ai": true allows AI extraction for pages without schema.org Event data (costs tokens).
INGEST_SOURCES=[]
INGEST_MODEL=claude-haiku-4-5
INGEST_AI_MAX_CHARS=24000

# --- Chat cost controls (defaults shown) ---
CHAT_MAX_OUTPUT_TOKENS=700
CHAT_MAX_INPUT_CHARS=500
CHAT_HISTORY_WINDOW=6
CHAT_HISTORY_MESSAGE_CHARS=1200
CHAT_MAX_TOOL_ROUNDS=3
CHAT_SEARCH_RESULT_LIMIT=8
CHAT_RATE_LIMIT_PER_MINUTE=8

# --- Deploy-time ---
# Set to "true" for one deploy to load the fictional demo tournaments into the database.
SEED_DEMO_DATA=false

# Keep real values in Vercel (Project → Settings → Environment Variables), not in files.
# Local scripts get them with `vercel env run` (see README → Secrets).
